# Copy to .env (git-ignored) and fill in. Spring Boot does NOT read .env by itself:
# set these as environment variables (see README) or in your IDE run configuration.

DB_URL=jdbc:mysql://localhost:3306/clouddrop?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=change_me
DB_PASSWORD=change_me

# At least 32 characters. Generate one, e.g. PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=change_me_to_a_long_random_string_of_32_plus_chars
JWT_EXPIRATION_HOURS=24

# Absolute path OUTSIDE the project folder
UPLOAD_DIR=C:/clouddrop-data/uploads
